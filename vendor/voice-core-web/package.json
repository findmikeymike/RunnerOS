{
  "name": "@voice-core/web",
  "version": "0.1.0",
  "private": true,
  "description": "Vite-oriented browser SDK for realtime conversational Voice Core applications",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/nichetypes/voice-core-rs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./cloud": {
      "types": "./dist/cloud.d.ts",
      "import": "./dist/cloud.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./server/voicecore-session.mjs.d.ts",
      "import": "./server/voicecore-session.mjs"
    },
    "./server/entitlement": {
      "types": "./server/voicecore-entitlement.mjs.d.ts",
      "import": "./server/voicecore-entitlement.mjs"
    },
    "./server/llm-credential": {
      "types": "./server/voicecore-llm-credential.mjs.d.ts",
      "import": "./server/voicecore-llm-credential.mjs"
    },
    "./server/operator-gateway": {
      "types": "./server/voicecore-operator-gateway.mjs.d.ts",
      "import": "./server/voicecore-operator-gateway.mjs"
    }
  },
  "files": [
    "README.md",
    "dist",
    "pkg",
    "server"
  ],
  "dependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "nanoid": "3.3.18",
    "sharp": "0.35.4"
  }
}
