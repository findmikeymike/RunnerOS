+++ b/voice-core-rs/wrappers/web/contract-tests/inworld-phonemes.test.mjs
@@ -0,0 +1,118 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createInworldTtsTransport } from "../src/transport/inworld.ts";
+import { parseInworldPhonemes, InworldVisemeTimeline } from "../src/transport/inworld-phonemes.ts";
+const phone = (start, duration, viseme = "aei", symbol = "a") => ({ startTimeSeconds: start, durationSeconds: duration, visemeSymbol: viseme, phoneSymbol: symbol });
+const timing = (...phones) => ({ wordAlignment: { words: ["hello"], phoneticDetails: [{ wordIndex: 0, phones }] } });
+function setup(t, enabled = true) {
+  const oldWindow = globalThis.window, oldSocket = globalThis.WebSocket, sockets = [];
+  class FakeSocket extends EventTarget {
+    static CONNECTING = 0; static OPEN = 1; readyState = 0; sent = []; closes = 0;
+    constructor() { super(); sockets.push(this); }
+    send(data) { this.sent.push(JSON.parse(data)); }
+    close() { this.readyState = 3; this.closes++; }
+    message(result) { this.dispatchEvent(new MessageEvent("message", { data: JSON.stringify({ result }) })); }
+    open() { this.readyState = 1; this.dispatchEvent(new Event("open")); this.message({ contextCreated: {} }); }
+    audio(samples, timestampInfo) { this.message({ audioChunk: { audioContent: Buffer.from(samples.buffer).toString("base64"), timestampInfo } }); }
+  }
+  globalThis.window = { location: { href: "https://app.test/" } }; globalThis.WebSocket = FakeSocket;
+  const controller = new AbortController();
+  t.after(() => { controller.abort(); globalThis.window = oldWindow; globalThis.WebSocket = oldSocket; });
+  return { sockets, controller, transport: createInworldTtsTransport({ phonemeTimestamps: enabled }) };
+}
+async function session(t, enabled = true) {
+  const state = setup(t, enabled), stream = await state.transport.createStreamingSession(state.controller.signal), socket = state.sockets[0];
+  socket.open(); await stream.pushText("Hello", true); return { ...state, stream, socket };
+}
+async function collect(stream) { const result = []; for await (const chunk of stream) result.push(chunk); return result; }
+test("official word phonetics distinguish silence from bilabial consonants", () => {
+  const result = parseInworldPhonemes({ wordAlignment: { words: ["", "be"], phoneticDetails: [
+    { wordIndex: 0, phones: [phone(0, .24, "bmp", "[silence]")] },
+    { wordIndex: 1, isPartial: false, phones: [phone(.24, .05, "bmp", "b"), phone(.29, .06, "ee", "i")] },
+  ] } });
+  assert.deepEqual(result.map(cue => cue.viseme), ["sil", "bmp", "ee"]);
+});
+test("malformed partial excessive and unknown metadata safely declines alignment", () => {
+  for (const value of [null, {}, timing(), timing(phone(-1, .1)), timing(phone(0, Infinity)), timing(phone(0, .1, "bogus")), timing(phone(0, 121)), timing(phone(0, .2), phone(.1, .2)),
+    { wordAlignment: { words: ["a"], phoneticDetails: [{ wordIndex: 0, isPartial: true, phones: [phone(0, .1)] }] } },
+    { wordAlignment: { words: ["a", "b"], phoneticDetails: [{ wordIndex: 0, phones: [phone(0, .1)] }] } },
+    timing(...Array.from({length: 4097}, () => phone(0, .1)))]) assert.equal(parseInworldPhonemes(value), undefined);
+});
+test("WORD and SYNC are opt in", async t => {
+  const { stream, socket } = await session(t);
+  assert.equal(socket.sent[0].create.timestampType, "WORD"); assert.equal(socket.sent[0].create.timestampTransportStrategy, "SYNC");
+  socket.message({ flushCompleted: {} }); await collect(stream);
+  const state = await session(t, false); assert.equal(state.socket.sent[0].create.timestampType, undefined);
+  state.socket.message({ flushCompleted: {} }); await collect(state.stream);
+});
+test("cumulative clock remaps crossfade tails and final flush without drift", async t => {
+  const { stream, socket } = await session(t);
+  socket.audio(new Int16Array(1600).fill(1000), timing(phone(0, .1)));
+  socket.audio(new Int16Array(1600).fill(2000), timing(phone(.1, .1, "bmp", "b")));
+  socket.audio(new Int16Array(1600).fill(3000), timing(phone(.2, .1, "ee", "i")));
+  socket.message({ flushCompleted: {} }); const chunks = await collect(stream);
+  assert.deepEqual(chunks.map(c => c.frames.length), [1120, 1120, 1120, 480]);
+  const cues = chunks.map(c => c.visemes.map(v => [Math.round(v.startMs), Math.round(v.endMs), v.viseme]));
+  assert.deepEqual(cues, [[[0,70,"aei"]], [[0,15,"aei"],[15,70,"bmp"]], [[0,15,"bmp"],[15,70,"ee"]], [[0,30,"ee"]]]);
+});
+test("metadata path preserves original PCM including tiny chunks crossfades and fades", async t => {
+  const input = [23, 200, 1900, 57, 960, 800].map((length, i) => Int16Array.from({length}, (_, j) => Math.round(Math.sin(j / 7 + i) * 20000)));
+  const enabled = await session(t); let start = 0;
+  for (const samples of input) { enabled.socket.audio(samples, timing(phone(start / 16000, samples.length / 16000))); start += samples.length; }
+  enabled.socket.message({ flushCompleted: {} }); const aligned = await collect(enabled.stream);
+  const disabled = await session(t, false); for (const samples of input) disabled.socket.audio(samples);
+  disabled.socket.message({ flushCompleted: {} }); const original = await collect(disabled.stream);
+  assert.deepEqual(aligned.map(c => c.frames), original.map(c => c.frames)); assert.ok(aligned.every(c => c.visemes !== undefined));
+  for (const chunk of aligned) for (const cue of chunk.visemes) assert.ok(cue.startMs >= 0 && cue.endMs <= chunk.frames.length / 16 + .00001);
+});
+test("absent malformed unrelated and partial timing use amplitude fallback", async t => {
+  for (const info of [undefined, {}, timing(phone(9, .1)), { wordAlignment: { words: ["a"], phoneticDetails: [{ wordIndex: 0, isPartial: true, phones: [phone(0, .1)] }] } }]) {
+    const { stream, socket } = await session(t); socket.audio(new Int16Array(1600), info); socket.message({ flushCompleted: {} });
+    assert.ok((await collect(stream)).every(c => c.visemes === undefined));
+  }
+});
+test("silence has empty cues and trailing metadata can annotate held audio only", async t => {
+  const { stream, socket } = await session(t);
+  socket.audio(new Int16Array(1600), timing(phone(0, .1, "bmp", "[silence]")));
+  socket.audio(new Int16Array(1600)); socket.message({ audioChunk: { timestampInfo: timing(phone(.1, .1, "ee", "i")) } });
+  socket.message({ flushCompleted: {} }); const chunks = await collect(stream);
+  assert.deepEqual(chunks[0].visemes, []); assert.equal(chunks[1].visemes, undefined); assert.equal(chunks[2].visemes[0].viseme, "ee");
+});
+test("reordered duplicate metadata is idempotent and never certifies later missing audio", () => {
+  const timeline = new InworldVisemeTimeline(); timeline.ingest(timing(phone(.1, .1, "ee", "i"))); timeline.ingest(timing(phone(0, .1))); timeline.ingest(timing(phone(.1, .1, "ee", "i")));
+  assert.equal(timeline.project([{ offset: 0, sourceStart: 0, length: 3200 }], 16000).length, 2);
+  timeline.ingest(timing(phone(0, .1)), { startMs: 200, endMs: 300 }); assert.equal(timeline.project([{ offset: 0, sourceStart: 3200, length: 1600 }], 16000), undefined);
+});
+test("abort clears timed audio closes once and ignores late provider data", async t => {
+  const { stream, socket, controller } = await session(t); socket.audio(new Int16Array(1600), timing(phone(0, .1))); controller.abort(); socket.audio(new Int16Array(1600), timing(phone(.1, .1)));
+  await assert.rejects(collect(stream), { name: "AbortError" }); assert.equal(socket.closes, 1);
+});
+test("conflicting out-of-order metadata cannot overlap an accepted source timeline", () => {
+  const timeline = new InworldVisemeTimeline();
+  timeline.ingest(timing(phone(0, .1)));
+  timeline.ingest(timing(phone(.05, .1, "bmp", "b")));
+  assert.deepEqual(timeline.project([{ offset: 0, sourceStart: 0, length: 1600 }], 16000).map(c => c.viseme), ["aei"]);
+  assert.equal(timeline.project([{ offset: 0, sourceStart: 1600, length: 800 }], 16000), undefined);
+  timeline.clear(); assert.equal(timeline.project([{ offset: 0, sourceStart: 0, length: 1600 }], 16000), undefined);
+});
+test("real TTS 2 Flash SYNC metadata and per-chunk WAV headers stay aligned", async t => {
+  const { readFileSync } = await import("node:fs");
+  const fixture = JSON.parse(readFileSync(new URL("./fixtures/inworld-phoneme-sync.json", import.meta.url), "utf8"));
+  const { stream, socket } = await session(t);
+  for (const chunk of fixture.chunks) {
+    // Reproduce real chunk sizes and WAV framing with synthetic PCM only.
+    const wav = Buffer.alloc(chunk.bytes);
+    wav.write("RIFF", 0); wav.writeUInt32LE(wav.length - 8, 4); wav.write("WAVEfmt ", 8);
+    wav.writeUInt32LE(16, 16); wav.writeUInt16LE(1, 20); wav.writeUInt16LE(1, 22);
+    wav.writeUInt32LE(fixture.sampleRate, 24); wav.writeUInt32LE(fixture.sampleRate * 2, 28);
+    wav.writeUInt16LE(2, 32); wav.writeUInt16LE(16, 34); wav.write("data", 36); wav.writeUInt32LE(wav.length - 44, 40);
+    socket.message({ audioChunk: { audioContent: wav.toString("base64"), timestampInfo: chunk.timestampInfo } });
+  }
+  socket.message({ flushCompleted: {} });
+  const chunks = await collect(stream);
+  assert.deepEqual(chunks.map(c => c.frames.length), [1600, 10400, 480]);
+  assert.deepEqual(chunks.map(c => c.visemes?.length), [3, 12, 1]);
+  assert.deepEqual(chunks[1].visemes.slice(0, 2).map(c => [c.startMs, c.endMs, c.viseme]), [[0, 15, "ee"], [15, 100, "bmp"]]);
+  assert.ok(chunks.every(c => c.visemes !== undefined));
+  assert.equal(parseInworldPhonemes(fixture.finalSilence)[0].viseme, "sil");
+});
