+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { ConsumedAudioVisemeScheduler } from '../src/audio/ConsumedAudioVisemeScheduler.ts';
+
+const cue = (startMs, endMs, viseme) => ({ startMs, endMs, viseme });
+function fixture() {
+  const scheduler = new ConsumedAudioVisemeScheduler(); scheduler.beginEpoch(4);
+  return { scheduler, enqueue: (visemes, duration = 100) => scheduler.enqueueChunk({playbackEpoch:4,chunk:{visemes},outputFrames:duration * 48,outputSampleRate:48000}), sample: ms => scheduler.sample(4, Math.round(ms * 48), 48000) };
+}
+test('consumed clock freezes pose on underrun and unknown metadata retains fallback', () => {
+  const { enqueue, sample } = fixture();
+  enqueue([cue(0,100,'bmp')]); enqueue(undefined); enqueue([]);
+  assert.deepEqual(sample(50), [{symbol:'bmp',weight:1}]);
+  assert.deepEqual(sample(50), [{symbol:'bmp',weight:1}]);
+  assert.equal(sample(150), undefined); assert.deepEqual(sample(250), []);
+});
+test('blends adjacent shapes across chunk boundaries and keeps lip closure at full strength', () => {
+  const { enqueue, sample } = fixture();
+  enqueue([cue(0,100,'bmp')]); enqueue([cue(0,100,'o')]);
+  assert.deepEqual(sample(50),[{symbol:'bmp',weight:1}]);
+  const a=sample(90), b=sample(100), c=sample(110);
+  assert.ok(Math.abs(a[0].weight-.7)<1e-6);
+  assert.deepEqual(b,[{symbol:'bmp',weight:.5},{symbol:'o',weight:.5}]);
+  assert.ok(Math.abs(c[1].weight-.7)<1e-6);
+  assert.equal(sample(150)[0].symbol,'o');
+});
+test('split identical cues remain continuous and explicit gaps close', () => {
+  const { enqueue, sample } = fixture();
+  enqueue([cue(0,100,'fv')]); enqueue([cue(0,100,'fv')]); enqueue([]);
+  assert.deepEqual(sample(100),[{symbol:'fv',weight:1}]);
+  assert.deepEqual(sample(225),[]);
+});
+test('stale epochs never erase queued current-turn metadata', () => {
+  const { scheduler, enqueue, sample }=fixture(); enqueue([cue(0,100,'o')]);
+  assert.equal(scheduler.sample(3,2400,48000),undefined);
+  assert.deepEqual(sample(50),[{symbol:'o',weight:1}]);
+  scheduler.beginEpoch(5);
+  assert.equal(sample(50),undefined);
+  scheduler.enqueueChunk({playbackEpoch:4,chunk:{visemes:[cue(0,100,'o')]},outputFrames:4800,outputSampleRate:48000});
+  assert.equal(scheduler.sample(5,2400,48000),undefined);
+});
+test('pruned silence and sample-rate changes do not shift later chunks', () => {
+  const { scheduler, enqueue, sample }=fixture();
+  enqueue([cue(0,100,'o')]); sample(100);
+  enqueue([cue(0,100,'bmp')]);
+  assert.deepEqual(sample(150),[{symbol:'bmp',weight:1}]);
+  scheduler.enqueueChunk({playbackEpoch:4,chunk:{visemes:[cue(0,100,'fv')]},outputFrames:4410,outputSampleRate:44100});
+  assert.deepEqual(scheduler.sample(4,11025,44100),[{symbol:'fv',weight:1}]);
+  assert.equal(sample(200),undefined); // stale decreasing cursor
+});
+test('malformed metadata falls back and bounded pressure never rewinds positions', () => {
+  const { scheduler, enqueue, sample }=fixture();
+  enqueue([{startMs:0,endMs:100,viseme:null}]); assert.equal(sample(50),undefined);
+  for(let i=0;i<5000;i++) enqueue([]);
+  assert.ok(scheduler.chunks.length<=4096);
+  assert.ok(scheduler.queuedEnd>500);
+  scheduler.reset(); assert.equal(sample(50),undefined);
+});
