diff --git a/voice-core-rs/wrappers/web/contract-tests/playback-observation.test.mjs b/voice-core-rs/wrappers/web/contract-tests/playback-observation.test.mjs
new file mode 100644
index 0000000..8ba4124
--- /dev/null
+++ b/voice-core-rs/wrappers/web/contract-tests/playback-observation.test.mjs
@@ -0,0 +1,197 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { createHash } from 'node:crypto';
+import test from 'node:test';
+import vm from 'node:vm';
+import ts from 'typescript';
+import { BoundedAudioDispatcher } from '../src/audio/BoundedAudioDispatcher.ts';
+
+async function workletFixture() {
+  let Processor;
+  class AudioWorkletProcessor {
+    constructor() {
+      this.port = { onmessage: null, messages: [], postMessage: message => this.port.messages.push(message) };
+    }
+  }
+  vm.runInNewContext(await readFile(new URL('../src/audio/output-worklet.js', import.meta.url), 'utf8'), {
+    AudioWorkletProcessor, Float32Array, Math, sampleRate: 48_000,
+    registerProcessor: (_, implementation) => { Processor = implementation; },
+  });
+  const processor = new Processor({ processorOptions: { playbackEpoch: 17 } });
+  return {
+    processor,
+    send: data => processor.port.onmessage({ data }),
+    frames: () => processor.port.messages.filter(message => message.type === 'playbackFrame'),
+    render: () => {
+      const output = new Float32Array(128);
+      assert.equal(processor.process([], [[output]]), true);
+      return output;
+    },
+  };
+}
+
+test('meter follows rendered PCM including fade-in, never the queued prebuffer', async () => {
+  const { send, frames, render } = await workletFixture();
+  send({ type: 'output', frames: new Float32Array(960).fill(0.5) });
+  assert.equal(frames().length, 0);
+  assert.ok(render().every(sample => sample === 0));
+  assert.equal(frames().length, 0);
+  send({ type: 'flushOutput', requestId: 1 });
+  const actual = render();
+  const rms = Math.sqrt(actual.reduce((sum, sample) => sum + sample * sample, 0) / actual.length);
+  assert.equal(frames().at(-1).level, rms);
+  assert.equal(frames().at(-1).active, true);
+  assert.equal(frames().at(-1).playbackEpoch, 17);
+  assert.ok(rms > 0 && rms < 0.5, 'meter includes the existing fade');
+});
+
+test('silence resets on the first silent quantum before playback grace completes', async () => {
+  const { processor, send, frames, render } = await workletFixture();
+  send({ type: 'output', frames: new Float32Array(4800).fill(0.5) });
+  let lastAudible = false;
+  for (let index = 0; index < 60; index++) {
+    const audible = render().some(sample => sample !== 0);
+    if (lastAudible && !audible) {
+      assert.equal(frames().at(-1).active, false);
+      assert.equal(frames().at(-1).level, 0);
+      assert.equal(processor.active, true, 'response grace must stay independent');
+      return;
+    }
+    lastAudible = audible;
+  }
+  assert.fail('expected rendered tail followed by silence');
+});
+
+test('queued silent PCM also closes the meter immediately', async () => {
+  const { send, frames, render } = await workletFixture();
+  const pcm = new Float32Array(4800);
+  pcm.fill(0.4, 0, 256);
+  send({ type: 'output', frames: pcm });
+  render(); render();
+  assert.ok(render().every(sample => sample === 0));
+  assert.equal(frames().at(-1).active, false);
+  assert.equal(frames().at(-1).level, 0);
+});
+
+test('audible observations are bounded to 30 Hz and finite normalized RMS', async () => {
+  const { send, frames, render } = await workletFixture();
+  send({ type: 'output', frames: new Float32Array(48000).fill(2) });
+  for (let quantum = 0; quantum < 375; quantum++) render();
+  assert.ok(frames().length >= 28 && frames().length <= 30);
+  assert.ok(frames().every(frame => frame.active && frame.level >= 0 && frame.level <= 1));
+});
+
+test('clear resets immediately and all later observations carry the new epoch', async () => {
+  const { send, frames, render } = await workletFixture();
+  send({ type: 'output', frames: new Float32Array(4800).fill(0.5) });
+  render();
+  send({ type: 'clearOutput', playbackEpoch: 18 });
+  assert.equal(frames().at(-1).active, false);
+  assert.equal(frames().at(-1).playbackEpoch, 18);
+  assert.ok(render().every(sample => sample === 0));
+  send({ type: 'output', frames: new Float32Array(4800).fill(0.2) });
+  render();
+  assert.equal(frames().at(-1).active, true);
+  assert.equal(frames().at(-1).playbackEpoch, 18);
+});
+
+test('output PCM matches the pre-observation implementation across fade, underrun and clear', async () => {
+  const { send, render } = await workletFixture();
+  const digest = createHash('sha256');
+  const pcm = Float32Array.from({ length: 5000 }, (_, index) => Math.sin(index / 9) * 0.4);
+  send({ type: 'output', frames: pcm });
+  for (let index = 0; index < 110; index++) digest.update(new Uint8Array(render().buffer));
+  send({ type: 'output', frames: pcm });
+  for (let index = 0; index < 7; index++) digest.update(new Uint8Array(render().buffer));
+  send({ type: 'clearOutput', playbackEpoch: 18 });
+  for (let index = 0; index < 5; index++) digest.update(new Uint8Array(render().buffer));
+  // Captured from upstream c348947 before adding observation.
+  assert.equal(digest.digest('hex'), '18baf45a263d72c600ec19ac145202b3bc4ac8d1e9f12ab47647ef93c0d6cee8');
+});
+
+async function graphFixture() {
+  class Node {
+    constructor(_context, _name, options) { this.options = options; }
+    gain = { value: 1 };
+    port = { onmessage: null, sent: [], postMessage(message) { this.sent.push(message); } };
+    connect() {}
+    disconnect() {}
+  }
+  class Context extends EventTarget {
+    state = 'running'; sampleRate = 48_000; destination = {};
+    audioWorklet = { addModule: async () => {} };
+    createGain() { return new Node(); }
+    async resume() {}
+    async close() {}
+  }
+  const source = await readFile(new URL('../src/audio/AudioGraph.ts', import.meta.url), 'utf8');
+  const executable = ts.transpileModule(
+    source.replace(/^import[\s\S]*?;\n/gm, '')
+      .replace('export class AudioGraph', 'class AudioGraph')
+      .replaceAll('import.meta.url', JSON.stringify('https://app.test/AudioGraph.js')) + '\nglobalThis.Graph = AudioGraph;',
+    { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext } },
+  ).outputText;
+  const context = {
+    URL, Float32Array, setTimeout, clearTimeout, BoundedAudioDispatcher,
+    window: { AudioContext: Context, setTimeout, clearTimeout },
+    navigator: { mediaDevices: { getUserMedia: async () => ({ getTracks: () => [], getAudioTracks: () => [] }) } },
+    MediaStreamAudioSourceNode: Node, AudioWorkletNode: Node,
+    OutputAdmissionTracker: class { cancelAll() {} },
+    StreamingResampler: class { reset() {} },
+  };
+  vm.runInNewContext(executable, context);
+  const graph = new context.Graph();
+  await graph.start({});
+  return graph;
+}
+
+test('graph fences old messages after clear, stop and restart and isolates observer errors', async () => {
+  const graph = await graphFixture();
+  const seen = [];
+  graph.setPlaybackFrameHandler(frame => seen.push(frame));
+  const oldPort = graph.outputNode.port;
+  const oldCallback = oldPort.onmessage;
+  const epoch = graph.outputNode.options.processorOptions.playbackEpoch;
+  const deliver = (callback, playbackEpoch, level = 0.5) => callback({ data: {
+    type: 'playbackFrame', playbackEpoch, level, active: true,
+  } });
+  deliver(oldCallback, epoch);
+  assert.equal(seen.at(-1).active, true);
+  graph.clearOutputQueue();
+  assert.equal(seen.at(-1).active, false);
+  const count = seen.length;
+  deliver(oldCallback, epoch);
+  assert.equal(seen.length, count);
+  const nextEpoch = oldPort.sent.at(-1).playbackEpoch;
+  deliver(oldCallback, nextEpoch);
+  assert.equal(seen.at(-1).active, true);
+  deliver(oldCallback, nextEpoch, NaN);
+  assert.equal(seen.at(-1).level, 0.5);
+  graph.setPlaybackFrameHandler(() => { throw new Error('broken graphics'); });
+  assert.doesNotThrow(() => deliver(oldCallback, nextEpoch));
+  graph.setPlaybackFrameHandler(frame => seen.push(frame));
+  graph.cancelPendingStart(); // Public Stop calls this before async teardown.
+  assert.equal(seen.at(-1).active, false);
+  deliver(oldCallback, nextEpoch);
+  assert.equal(seen.at(-1).active, false);
+  await graph.stop();
+  await graph.start({});
+  deliver(oldCallback, nextEpoch);
+  assert.equal(seen.at(-1).active, false);
+  deliver(graph.outputNode.port.onmessage, graph.outputNode.options.processorOptions.playbackEpoch);
+  assert.equal(seen.at(-1).active, true);
+  await graph.stop();
+  assert.equal(seen.at(-1).level, 0);
+});
+
+
+test('missing output channels reset observation without consuming queued PCM', async () => {
+  const { processor, send, frames, render } = await workletFixture();
+  send({ type: 'output', frames: new Float32Array(4800).fill(0.4) });
+  render();
+  const queued = processor.queuedSamples;
+  processor.process([], []);
+  assert.equal(processor.queuedSamples, queued);
+  assert.equal(frames().at(-1).active, false);
+  assert.equal(frames().at(-1).level, 0);
+});
