--- /dev/null
+++ b/voice-core-rs/wrappers/web/contract-tests/playback-observation.test.mjs
@@ -0,0 +1,217 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { createHash } from 'node:crypto';
+import test from 'node:test';
+import vm from 'node:vm';
+import ts from 'typescript';
+import { BoundedAudioDispatcher } from '../src/audio/BoundedAudioDispatcher.ts';
+
+async function workletFixture() {
+  let Processor;
+  class AudioWorkletProcessor {
+    constructor() {
+      this.port = { onmessage: null, messages: [], postMessage: message => this.port.messages.push(message) };
+    }
+  }
+  vm.runInNewContext(await readFile(new URL('../src/audio/output-worklet.js', import.meta.url), 'utf8'), {
+    AudioWorkletProcessor, Float32Array, Math, sampleRate: 48_000,
+    registerProcessor: (_, implementation) => { Processor = implementation; },
+  });
+  const processor = new Processor({ processorOptions: { playbackEpoch: 17 } });
+  return {
+    processor,
+    send: data => processor.port.onmessage({ data }),
+    frames: () => processor.port.messages.filter(message => message.type === 'playbackFrame'),
+    render: () => {
+      const output = new Float32Array(128);
+      assert.equal(processor.process([], [[output]]), true);
+      return output;
+    },
+  };
+}
+
+test('meter follows rendered PCM including fade-in, never the queued prebuffer', async () => {
+  const { send, frames, render } = await workletFixture();
+  send({ type: 'output', frames: new Float32Array(960).fill(0.5) });
+  assert.equal(frames().length, 0);
+  assert.ok(render().every(sample => sample === 0));
+  assert.equal(frames().length, 0);
+  send({ type: 'flushOutput', requestId: 1 });
+  const actual = render();
+  const rms = Math.sqrt(actual.reduce((sum, sample) => sum + sample * sample, 0) / actual.length);
+  assert.equal(frames().at(-1).level, rms);
+  assert.equal(frames().at(-1).active, true);
+  assert.equal(frames().at(-1).playbackEpoch, 17);
+  assert.ok(rms > 0 && rms < 0.5, 'meter includes the existing fade');
+});
+
+test('silence resets on the first silent quantum before playback grace completes', async () => {
+  const { processor, send, frames, render } = await workletFixture();
+  send({ type: 'output', frames: new Float32Array(4800).fill(0.5) });
+  let lastAudible = false;
+  for (let index = 0; index < 60; index++) {
+    const audible = render().some(sample => sample !== 0);
+    if (lastAudible && !audible) {
+      assert.equal(frames().at(-1).active, false);
+      assert.equal(frames().at(-1).level, 0);
+      assert.equal(processor.active, true, 'response grace must stay independent');
+      return;
+    }
+    lastAudible = audible;
+  }
+  assert.fail('expected rendered tail followed by silence');
+});
+
+test('queued silent PCM also closes the meter immediately', async () => {
+  const { send, frames, render } = await workletFixture();
+  const pcm = new Float32Array(4800);
+  pcm.fill(0.4, 0, 256);
+  send({ type: 'output', frames: pcm });
+  render(); render();
+  assert.ok(render().every(sample => sample === 0));
+  assert.equal(frames().at(-1).active, false);
+  assert.equal(frames().at(-1).level, 0);
+});
+
+test('audible observations are bounded to 30 Hz and finite normalized RMS', async () => {
+  const { send, frames, render } = await workletFixture();
+  send({ type: 'output', frames: new Float32Array(48000).fill(2) });
+  for (let quantum = 0; quantum < 375; quantum++) render();
+  assert.ok(frames().length >= 28 && frames().length <= 30);
+  assert.ok(frames().every(frame => frame.active && frame.level >= 0 && frame.level <= 1));
+});
+
+test('clear resets immediately and all later observations carry the new epoch', async () => {
+  const { send, frames, render } = await workletFixture();
