# Copy to a secure local env file or CI secret store. Never commit live values.
# Pricing is configured in Lemon Squeezy; no dollar amount is hard-coded in the app or service.

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Test Worker
ARTIST_OS_ENTITLEMENT_D1_DATABASE_ID_TEST=
ARTIST_OS_ENTITLEMENT_READY_URL_TEST=

# Production Worker
ARTIST_OS_ENTITLEMENT_D1_DATABASE_ID_PRODUCTION=
ARTIST_OS_ENTITLEMENT_READY_URL_PRODUCTION=https://license.artistos.app/readyz

# Lemon Squeezy commerce
LEMON_STORE_ID=
LEMON_PRODUCT_ID=
# Premium-first launch: keep this exact sentinel until a Basic checkout exists.
LEMON_VARIANT_ID_BASIC_V1=disabled
LEMON_VARIANT_ID_PREMIUM_V1=
LEMON_API_KEY=
LEMON_WEBHOOK_SECRET=

# Entitlement signing
ARTIST_OS_ENTITLEMENT_KEY_ID_CURRENT=
ARTIST_OS_ENTITLEMENT_SIGNING_KEY_CURRENT=
ARTIST_OS_ENTITLEMENT_VERIFICATION_KEYS_JSON=

# Direct macOS release automation
MACOS_CERTIFICATE_P12_BASE64=
MACOS_CERTIFICATE_PASSWORD=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Optional local keychain signing path instead of CSC_LINK
CSC_NAME=
