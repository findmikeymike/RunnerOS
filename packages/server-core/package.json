{
  "name": "@craft-agent/server-core",
  "version": "0.8.13",
  "license": "Apache-2.0",
  "description": "Reusable headless server infrastructure for Runner",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transport": "./src/transport/index.ts",
    "./outputs": "./src/outputs/OutputService.ts",
    "./release-kit": "./src/release-kit/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./workflows/durable-read-runner": "./src/workflows/durable-read-runner.ts",
    "./workflows/durable-workflow-host": "./src/workflows/durable-workflow-host.ts",
    "./handlers": "./src/handlers/index.ts",
    "./bootstrap": "./src/bootstrap/index.ts",
    "./model-fetchers": "./src/model-fetchers/index.ts",
    "./domain": "./src/domain/index.ts",
    "./services": "./src/services/index.ts",
    "./handlers/rpc": "./src/handlers/rpc/index.ts",
    "./handlers/rpc/*": "./src/handlers/rpc/*.ts",
    "./sessions": "./src/sessions/index.ts",
    "./webui": "./src/webui/index.ts",
    "./triggers": "./src/triggers/index.ts",
    "./licensing": "./src/licensing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@craft-agent/core": "workspace:*",
    "@craft-agent/shared": "workspace:*",
    "sax": "1.4.4",
    "parse5": "8.0.1",
    "jose": "^6.0.0",
    "ws": "^8.19.0",
    "sharp": "0.34.5",
    "@earendil-works/pi-ai": "0.84.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sax": "1.2.7",
    "typescript": "^5.8.2"
  }
}
