# dependencies (bun install)
node_modules

# output
out
dist
*.tgz
.build
apps/electron/release
apps/electron/resources/session-mcp-server/
apps/electron/resources/pi-agent-server/

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
.dev.vars
.dev.vars.*

# caches
.eslintcache
.cache
*.tsbuildinfo
.wrangler
.mintlify
.omc/
.swarm/

# OSS sync temp directory
.oss-sync-temp/

# Local git worktrees kept inside the repo folder
.worktrees/

# IntelliJ based IDEs
.idea

# Python bytecode
__pycache__/
*.pyc

# Python virtualenvs and build metadata. tools/squad/vendor/squad is an
# installable project, so running uv/pip there can drop a 72 MB .venv into the
# tree; these must never be committed or packaged.
.venv/
*.egg-info/
uv.lock

# Finder (MacOS) folder config
.DS_Store

# Claude Code local settings (user-specific)
.claude/settings.local.json

# Accidental literal tilde directories (Node.js doesn't expand ~)
~/

# Lock files from other package managers
pnpm-lock.yaml

# Craft Agent local data (sessions, credentials, config)
.craft-agent/

# Local owner smoke profile: real keys, artist context, campaign context.
# Keep templates in smoke/templates/ tracked; keep filled values here ignored.
smoke/local/

# SSH keys and secrets
*.pem
*.key
sshkey
id_rsa*
id_ed25519*

# Credentials files
credentials.enc
*.credentials

# act (local GitHub Actions runner)
.secrets
.actrc

# Personal note files (TextEdit RTF bundles, scratch ideas, etc.)
*.rtfd
*.rtf
NOTES.md
notes.md
SCRATCH.md
scratch.md

# Workspace data dropped at repo root when launching the app from this directory
# (the electron app treats cwd as a workspace root). Real workspace data lives
# at ~/.craft-agent/workspaces/ — these top-level entries are accidental.
/.claude-plugin/
/config.json
/events.jsonl
/labels/
/statuses/
/views.json
/sessions/
/automations.json
/automations-history.jsonl
/automations-scheduler-state.json
/activated-agents.json

# Vendored Swift tools — keep source, exclude build artifacts
tools/**/.build/
tools/**/.swiftpm/
tools/**/dist/
tools/**/*.log
tools/**/runtime-manifest.json
tools/**/.DS_Store
apps/electron/.voice-core-dev/

# vendored prebuilt — the generic `dist` rule above silently dropped 22 files from a
# vendor update, leaving tracked code importing untracked files. Never ignore this dir.
!vendor/voice-core-web/dist/
!vendor/voice-core-web/dist/**
